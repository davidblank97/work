  <ElementType name="update_details" model="closed" content="eltOnly" order="seq">
    <element type="target" minOccurs="0" maxOccurs="1" />
    <element type="version" minOccurs="1" maxOccurs="1" />
    <element type="release_notes" minOccurs="1" maxOccurs="1" />
