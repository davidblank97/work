<Schema name="CONTROLLER_IO_MAP" xmlns="urn:schemas-microsoft-com:xml-data" xmlns:dt="urn:schemas-microsoft-com:datatypes" xmlns:version="1.8.3.2">

	<ElementType name="iomap" model="closed" content="eltOnly" order="seq">
		<!--DECLARE ELEMENTS (IOMAP)-->
		<element type="metadata" minOccurs="1" maxOccurs="1" />
		<element type="firmware_version" minOccurs="0" maxOccurs="1" />
		<element type="system" minOccurs="0" maxOccurs="1" />
		<element type="power" minOccurs="0" maxOccurs="1" />
		<element type="auxiliary_power" minOccurs="0" maxOccurs="*" />
		<element type="gas_controller" minOccurs="0" maxOccurs="1" />
		<element type="proximity_sensor" minOccurs="0" maxOccurs="1" />
		<element type="coolant" minOccurs="0" maxOccurs="1" />
		<element type="wire_manipulator" minOccurs="0" maxOccurs="1" />
		<element type="weldhead" minOccurs="0" maxOccurs="1" />
		<element type="keypad" minOccurs="0" maxOccurs="1" />
		<element type="pendant" minOccurs="0" maxOccurs="1" />
		<element type="timer" minOccurs="0" maxOccurs="*" />
		<element type="home_switch" minOccurs="0" maxOccurs="*" />
		<element type="wire_spool" minOccurs="0" maxOccurs="1" />
		<element type="digital_servo" minOccurs="0" maxOccurs="*" />
		<element type="digital_stepper" minOccurs="0" maxOccurs="*" />
		<element type="smart_servo" minOccurs="0" maxOccurs="*" />
		<element type="position" minOccurs="0" maxOccurs="*" />
		<element type="spares" minOccurs="0" maxOccurs="1" />
		<element type="hardware_detection" minOccurs="0" maxOccurs="1" />
		<element type="external" minOccurs="0" maxOccurs="1" />
		<element type="high_speed_data" minOccurs="0" maxOccurs="1" />
		<element type="firmware_test" minOccurs="0" maxOccurs="1" />
		<element type="hard_limits" minOccurs="0" maxOccurs="*" />
		<element type="analog_servo" minOccurs="0" maxOccurs="*" />

	</ElementType>

	<!--DEFINE ELEMENTS (IOMAP)-->
	<ElementType name="metadata" model="closed" content="eltOnly" order="seq">
		<!--DECLARE ALL ELEMENTS (METADATA)-->
		<element type="schema_version" minOccurs="1" maxOccurs="1" />
		<element type="config_version" minOccurs="1" maxOccurs="1" />
		<element type="author" minOccurs="0" maxOccurs="1" />
		<element type="date" minOccurs="0" maxOccurs="1" />
	</ElementType>
	<ElementType name="firmware_version" model="closed" content="eltOnly" order="seq">
		<element type="control_board" minOccurs="0" maxOccurs="1" />
		<element type="servo_board" minOccurs="0" maxOccurs="1" />
		<element type="stepper_board" minOccurs="0" maxOccurs="1" />
	</ElementType>
	<ElementType name="system" model="closed" content="eltOnly" order="seq">
		<!--DECLARE ELEMENTS (SYSTEM)-->
		<element type="io" minOccurs="1" maxOccurs="*" />
	</ElementType>

	<ElementType name="power" model="closed" content="eltOnly" order="seq">
		<!--DECLARE ELEMENTS (POWER)-->
		<element type="timer_index" minOccurs="0" maxOccurs="1" />
		<element type="io" minOccurs="0" maxOccurs="*" />
	</ElementType>

	<ElementType name="auxiliary_power" model="closed" content="eltOnly" order="seq">
		<AttributeType name="index" required="yes" dt:type="string" />
		<attribute type="index" />
		<!--DECLARE ELEMENTS (AUX POWER)-->
		<element type="io" minOccurs="1" maxOccurs="*" />
	</ElementType>

	<ElementType name="gas_controller" model="closed" content="eltOnly" order="seq">
		<!--DECLARE ELEMENTS (GAS CONTROLLER)-->
		<element type="io" minOccurs="1" maxOccurs="*" />
	</ElementType>

	<ElementType name="proximity_sensor" model="closed" content="eltOnly" order="seq">
		<!--DECLARE ELEMENTS (PROXIMITY SENSOR)-->
		<element type="io" minOccurs="1" maxOccurs="*" />
	</ElementType>

	<ElementType name="coolant" model="closed" content="eltOnly" order="seq">
		<!--DECLARE ELEMENTS (COOLANT)-->
		<element type="io" minOccurs="1" maxOccurs="*" />
	</ElementType>

	<ElementType name="wire_manipulator" model="closed" content="eltOnly" order="seq">
		<!--DECLARE ELEMENTS (WIRE MANIPULATOR)-->
		<element type="io" minOccurs="1" maxOccurs="*" />
	</ElementType>

	<ElementType name="weldhead" model="closed" content="eltOnly" order="seq">
		<!--DECLARE ELEMENTS (WELDHEAD)-->
		<element type="io" minOccurs="1" maxOccurs="*" />
	</ElementType>

	<ElementType name="keypad" model="closed" content="eltOnly" order="seq">
		<!--DECLARE ELEMENTS (KEYPAD)-->
		<element type="io" minOccurs="1" maxOccurs="*" />
	</ElementType>

	<ElementType name="pendant" model="closed" content="eltOnly" order="seq">
		<!--DECLARE ELEMENTS (PENDANT)-->
		<element type="io" minOccurs="1" maxOccurs="*" />
	</ElementType>

	<ElementType name="timer" model="closed" content="eltOnly" order="seq">
		<AttributeType name="index" required="yes" dt:type="string" />
		<attribute type="index" />
		<!--DECLARE ELEMENTS (TIMER)-->
		<element type="io" minOccurs="1" maxOccurs="*" />
	</ElementType>

	<ElementType name="digital_servo" model="closed" content="eltOnly" order="seq">
		<AttributeType name="index" required="yes" dt:type="string" />
		<attribute type="index" />
		<!--DECLARE ELEMENTS (SERVO)-->
		<element type="io" minOccurs="0" maxOccurs="*" />
	</ElementType>

	<ElementType name="digital_stepper" model="closed" content="eltOnly" order="seq">
		<AttributeType name="index" required="yes" dt:type="string" />
		<attribute type="index" />
		<!--DECLARE ELEMENTS (STEPPER)-->
		<element type="io" minOccurs="0" maxOccurs="*" />
	</ElementType>

	<ElementType name="smart_servo" model="closed" content="eltOnly" order="seq">
		<AttributeType name="index" required="yes" dt:type="string" />
		<attribute type="index" />
		<!--DECLARE ELEMENTS (STEPPER)-->
		<element type="io" minOccurs="0" maxOccurs="*" />
	</ElementType>

	<ElementType name="position" model="closed" content="eltOnly" order="seq">
		<AttributeType name="index" required="yes" dt:type="string" />
		<attribute type="index" />
		<element type="io" minOccurs="0" maxOccurs="*" />
	</ElementType>

	<ElementType name="hard_limits" model="closed" content="eltOnly" order="seq">
		<AttributeType name="index" required="yes" dt:type="string" />
		<attribute type="index" />
		<element type="io" minOccurs="0" maxOccurs="*" />
	</ElementType>

	<ElementType name="wire_spool" model="closed" content="eltOnly" order="seq">
		<!--DECLARE ELEMENTS (WIRE SPOOL)-->
		<element type="io" minOccurs="1" maxOccurs="*" />
	</ElementType>

	<ElementType name="spares" model="closed" content="eltOnly" order="seq">
		<!--DECLARE ELEMENTS (WIRE SPOOL)-->
		<element type="io" minOccurs="1" maxOccurs="*" />
	</ElementType>

	<ElementType name="hardware_detection" model="closed" content="eltOnly" order="seq">
		<!--DECLARE ELEMENTS (WIRE SPOOL)-->
		<element type="io" minOccurs="1" maxOccurs="*" />
	</ElementType>

	<ElementType name="external" model="closed" content="eltOnly" order="seq">
		<!--DECLARE ELEMENTS (WIRE SPOOL)-->
		<element type="io" minOccurs="1" maxOccurs="*" />
	</ElementType>

	<ElementType name="high_speed_data" model="closed" content="eltOnly" order="seq">
		<!--DECLARE ELEMENTS (WIRE SPOOL)-->
		<element type="io" minOccurs="1" maxOccurs="*" />
	</ElementType>

	<ElementType name="firmware_test" model="closed" content="eltOnly" order="seq">
		<!--DECLARE ELEMENTS (FIRMWARE TEST)-->
		<element type="io" minOccurs="1" maxOccurs="*" />
	</ElementType>

	<ElementType name="home_switch" model="closed" content="eltOnly" order="seq">
		<AttributeType name="index" required="yes" dt:type="string" />
		<attribute type="index" />
		<!--DECLARE ELEMENTS (HOME SWITCH)-->
		<element type="io" minOccurs="1" maxOccurs="*" />
	</ElementType>
	
	<ElementType name="analog_servo" model="closed" content="eltOnly" order="seq">
		<AttributeType name="index" required="yes" dt:type="string" />
		<attribute type="index" />
		<!--DECLARE ELEMENTS (SERVO)-->
		<element type="io" minOccurs="0" maxOccurs="*" />
	</ElementType>

	<!--DEFINE ELEMENTS (POWER)-->
	<ElementType name="timer_index" model="closed"  dt:type="string" content="textOnly" />

	<!--DEFINE ELEMENTS (METADATA)-->
	<ElementType name="schema_version" model="closed"  dt:type="string" content="textOnly" />
	<ElementType name="config_version" model="closed"  dt:type="string" content="textOnly" />
	<ElementType name="author" model="closed"  dt:type="string" content="textOnly" />
	<ElementType name="date" model="closed"  dt:type="string" content="textOnly" />

	<ElementType name="control_board" model="closed"  dt:type="string" content="textOnly" />
	<ElementType name="servo_board" model="closed"  dt:type="string" content="textOnly" />
	<ElementType name="stepper_board" model="closed"  dt:type="string" content="textOnly" />

	<!--DEFINE ELEMENTS (IO)-->
	<ElementType name="io" model="closed" content="eltOnly" order="seq">
		<AttributeType name="module" required="yes" dt:type="string" />
		<attribute type="module" />
		<!--DECLARE ELEMENTS (IO)-->
		<group order="one">
			<group order="seq">
				<!--system-->
				<element type="properties" minOccurs="1" maxOccurs="1" />
				<element type="camera_light_enable" minOccurs="0" maxOccurs="1" />
				<element type="power_up_type" minOccurs="0" maxOccurs="1" />
				<element type="power_enable" minOccurs="0" maxOccurs="1" />
				<element type="fan_enable" minOccurs="0" maxOccurs="1" />
				<element type="wire_stuck_check_enable" minOccurs="0" maxOccurs="1" />
				<element type="wire_stuck_check_status" minOccurs="0" maxOccurs="1" />
				<element type="avc_sense_select" minOccurs="0" maxOccurs="1" />
				<element type="beeper" minOccurs="0" maxOccurs="1" />
				<element type="watchdog" minOccurs="0" maxOccurs="1" />
				<element type="estop" minOccurs="0" maxOccurs="1" />
				<element type="lockout_mode" minOccurs="0" maxOccurs="1" />
				<element type="chopper_overtemp" minOccurs="0" maxOccurs="1" />
				<element type="work_detect" minOccurs="0" maxOccurs="1" />
				<element type="servo_fault" minOccurs="0" maxOccurs="1" />
				<element type="foot_pedal_enable" minOccurs="0" maxOccurs="1" />
				<element type="foot_pedal_control" minOccurs="0" maxOccurs="1" />
				<element type="dacMode" minOccurs="0" maxOccurs="1" />
				<element type="critical_fault_circuit" minOccurs="0" maxOccurs="1" />
				<element type="weldhead_switch_active" minOccurs="0" maxOccurs="1" />
				<element type="version" minOccurs="0" maxOccurs="1" />
				<element type="digital_head_ID" minOccurs="0" maxOccurs="1" />
				<element type="hotwire_plasma_contactor" minOccurs="0" maxOccurs="1" />
				<element type="cs300_temperature_fault" minOccurs="0" maxOccurs="1" />
				<element type="control_board_firmware_version" minOccurs="0" maxOccurs="1" />
				<element type="servo_board_firmware_version" minOccurs="0" maxOccurs="1" />
				<element type="stepper_board_firmware_version" minOccurs="0" maxOccurs="1" />
				<element type="control_board_firmware_revision" minOccurs="0" maxOccurs="1" />
				<element type="servo_board_firmware_revision" minOccurs="0" maxOccurs="1" />
				<element type="stepper_board_firmware_revision" minOccurs="0" maxOccurs="1" />
				<element type="camera_sync_trigger_mode" minOccurs="0" maxOccurs="1" />
				<element type="camera_sync_trigger_period" minOccurs="0" maxOccurs="1" />
				<element type="camera_sync_trigger_transition_delay" minOccurs="0" maxOccurs="1" />
				<element type="camera_sync_trigger_multiplier" minOccurs="0" maxOccurs="1" />
				<element type="motion_pulse_setpoint" minOccurs="0" maxOccurs="1" />
				<element type="beeper_external" minOccurs="0" maxOccurs="1" />
				<element type="camera_frames_per_pulse" minOccurs="0" maxOccurs="1" />
				<element type="camera_frames_per_second_remainder" minOccurs="0" maxOccurs="1" />
				<element type="camera_frame_grab_period" minOccurs="0" maxOccurs="1" />
				<element type="camera_frame_grab_period_multiplier" minOccurs="0" maxOccurs="1" />
				<element type="camera_frame_grab_on_time" minOccurs="0" maxOccurs="1" />
				<element type="camera_arc_on" minOccurs="0" maxOccurs="1" />
				<element type="pipe_head_lights" minOccurs="0" maxOccurs="1" />
				<element type="servo_velocity_smoothing_constant" minOccurs="0" maxOccurs="1" />
				<element type="power_monitoring_fault" minOccurs="0" maxOccurs="1" />
				<element type="servo_velocity_rise_time_smoothing_constant" minOccurs="0" maxOccurs="1" />
				<element type="pump_input_power" minOccurs="0" maxOccurs="1" />
				<element type="is_input_power_110" minOccurs="0" maxOccurs="*" />
				<element type="software_estop_reset" minOccurs="0" maxOccurs="1" />
			</group>
			<group order="seq">
				<!--power-->
				<element type="touch_sense_enable" minOccurs="0" maxOccurs="1" />
				<element type="is_short_circuit" minOccurs="0" maxOccurs="1" />
				<element type="vp_enable" minOccurs="0" maxOccurs="1" />
				<element type="arc_starter_enable" minOccurs="0" maxOccurs="*" />
				<element type="arc_enable" minOccurs="0" maxOccurs="*" />
				<element type="amperage_telemetry_input" minOccurs="0" maxOccurs="1" />
				<element type="avc_sense_connector_select" minOccurs="0" maxOccurs="1" />
				<element type="mig_relay_switch" minOccurs="0" maxOccurs="1" />
				<element type="arc_on" minOccurs="0" maxOccurs="*" />
				<element type="hot_wire_temp_fault" minOccurs="0" maxOccurs="1" />
				<element type="amperage_primary_setpoint" minOccurs="0" maxOccurs="1" />
				<element type="amperage_background_setpoint" minOccurs="0" maxOccurs="1" />
				<element type="amperage_setpoint" minOccurs="1" maxOccurs="1" />
				<element type="amperage_primary_telemetry" minOccurs="0" maxOccurs="1" />
				<element type="amperage_background_telemetry" minOccurs="0" maxOccurs="1" />
				<element type="amperage_telemetry" minOccurs="1" maxOccurs="1" />
				<element type="voltage_primary_telemetry" minOccurs="0" maxOccurs="1" />
				<element type="voltage_background_telemetry" minOccurs="0" maxOccurs="1" />
				<element type="voltage_telemetry" minOccurs="1" maxOccurs="1" />
				<element type="voltage_setpoint" minOccurs="0" maxOccurs="1" />
				<element type="voltage_deadband" minOccurs="0" maxOccurs="1" />
				<element type="voltage_square_wave_period" minOccurs="0" maxOccurs="1" />
				<element type="voltage_square_wave_period_multiplier" minOccurs="0" maxOccurs="1" />
				<element type="mig_pulse_settings" minOccurs="0" maxOccurs="1" />
				<element type="voltage_p_term" minOccurs="0" maxOccurs="1" />
				<element type="open_loop_on_time" minOccurs="0" maxOccurs="1" />
				<element type="open_loop_on_time_multiplier" minOccurs="0" maxOccurs="1" />
				<element type="min_on_time" minOccurs="0" maxOccurs="1" />
				<element type="max_on_time" minOccurs="0" maxOccurs="1" />
				<element type="mig_process_select" minOccurs="0" maxOccurs="1" />
				<element type="dt_current" minOccurs="0" maxOccurs="1" />
				<element type="dt_current_time" minOccurs="0" maxOccurs="1" />
				<element type="pulse_average_voltage_telemetry" minOccurs="0" maxOccurs="1" />
				<element type="detect_short_voltage" minOccurs="0" maxOccurs="1" />
				<element type="clear_short_voltage" minOccurs="0" maxOccurs="1" />
				<element type="clear_short_ramp_rate" minOccurs="0" maxOccurs="1" />
				<element type="mig_pulse_exponential_decay_factor" minOccurs="0" maxOccurs="1" />
				<element type="dynamics_threshold_voltage" minOccurs="0" maxOccurs="1" />
				<element type="dynamics_wetting_amps" minOccurs="0" maxOccurs="1" />
				<element type="dynamics_wetting_time" minOccurs="0" maxOccurs="1" />
				<element type="dynamics_wetting_ramp_rate" minOccurs="0" maxOccurs="1" />
				<element type="mig_arc_start_mode" minOccurs="0" maxOccurs="1" />
				<element type="mig_arc_start_initial_amps" minOccurs="0" maxOccurs="1" />
				<element type="mig_arc_start_initial_amps_time" minOccurs="0" maxOccurs="1" />
				<element type="mig_arc_start_initial_amps_multiplier" minOccurs="0" maxOccurs="1" />
				<element type="mig_process_enabled" minOccurs="0" maxOccurs="1" />
				<element type="mig_dynamics_short_status" minOccurs="0" maxOccurs="1" />
				<element type="mig_dynamics_start_delay" minOccurs="0" maxOccurs="1" />
				<element type="mig_dynamics_max_current" minOccurs="0" maxOccurs="1" />
				<element type="mig_dip_detachment_current" minOccurs="0" maxOccurs="1" />
				<element type="mig_dip_burnback_current" minOccurs="0" maxOccurs="1" />
				<element type="mig_dip_detachment_wetting_time" minOccurs="0" maxOccurs="1" />
				<element type="mig_dip_min_burnback_time" minOccurs="0" maxOccurs="1" />
				<element type="mig_dip_detachment_ramp_rate" minOccurs="0" maxOccurs="1" />
				<element type="pulse_average_current_telemetry" minOccurs="0" maxOccurs="1" />
				<element type="pulse_is_telemetry_valid" minOccurs="0" maxOccurs="1" />
				<element type="mig_open_circuit_current" minOccurs="0" maxOccurs="1" />
				<element type="mig_dip_blast_ramp_rate" minOccurs="0" maxOccurs="1" />
				<element type="mig_dip_burnback_ramp_rate" minOccurs="0" maxOccurs="1" />
				<element type="software_arc_pulse_state" minOccurs="0" maxOccurs="1" />
				<element type="mig_dip_pre_detachment_ramp_rate" minOccurs="0" maxOccurs="1" />
				<element type="mig_dip_energy_setpoint" minOccurs="0" maxOccurs="1" />
				<element type="mig_dip_energy_telemetry" minOccurs="0" maxOccurs="1" />
				<element type="mig_cv_average_period" minOccurs="0" maxOccurs="1" />
				<element type="mig_dip_detachment_wait_time" minOccurs="0" maxOccurs="1" />
				<element type="exponential_decay_period" minOccurs="0" maxOccurs="1" />
				<element type="power_telemetry_1" minOccurs="0" maxOccurs="1" />
				<element type="power_telemetry_2" minOccurs="0" maxOccurs="1" />
				<element type="power_telemetry_3" minOccurs="0" maxOccurs="1" />
				<element type="power_telemetry_4" minOccurs="0" maxOccurs="1" />
				<element type="voltage_telemetry_gain" minOccurs="0" maxOccurs="1" />
				<element type="voltage_telemetry_offset" minOccurs="0" maxOccurs="1" />
				<element type="current_telemetry_gain" minOccurs="0" maxOccurs="1" />
				<element type="current_telemetry_offset" minOccurs="0" maxOccurs="1" />
			</group>
			<group order="seq">
				<!--gas_controller-->
				<element type="shield_enable" minOccurs="0" maxOccurs="1" />
				<element type="shield_flow_rate" minOccurs="0" maxOccurs="1" />
				<element type="shield_flow_in" minOccurs="0" maxOccurs="1" />
				<element type="trail_enable" minOccurs="0" maxOccurs="1" />
				<element type="trail_flow_rate" minOccurs="0" maxOccurs="1" />
				<element type="trail_flow_in" minOccurs="0" maxOccurs="1" />
				<element type="plasma_enable" minOccurs="0" maxOccurs="1" />
				<element type="plasma_flow_rate" minOccurs="0" maxOccurs="1" />
				<element type="plasma_flow_in" minOccurs="0" maxOccurs="1" />
				<element type="backup_enable" minOccurs="0" maxOccurs="1" />
				<element type="backup_flow_rate" minOccurs="0" maxOccurs="1" />
				<element type="backup_flow_in" minOccurs="0" maxOccurs="1" />
			</group>
			<group order="seq">
				<!--proximity_sensor-->
				<element type="warning" minOccurs="1" maxOccurs="1" />
				<element type="error" minOccurs="1" maxOccurs="1" />
			</group>
			<group order="seq">
				<!--coolant-->
				<element type="cooler_enable" minOccurs="0" maxOccurs="1" />
				<element type="water_flow_in" minOccurs="0" maxOccurs="1" />
				<element type="water_flow_sense" minOccurs="0" maxOccurs="1" />
			</group>
			<group order="seq">
				<!--wire_manipulator-->
				<element type="enable_up_down" minOccurs="0" maxOccurs="1" />
				<element type="direction_up_down" minOccurs="0" maxOccurs="1" />
				<element type="enable_in_out" minOccurs="0" maxOccurs="1" />
				<element type="direction_in_out" minOccurs="0" maxOccurs="1" />
				<element type="side_switch" minOccurs="1" maxOccurs="1" />
				<element type="servo_side_switch" minOccurs="0" maxOccurs="1" />
			</group>
			<group order="seq">
				<!--auxiliary_power-->
				<element type="enable" minOccurs="1" maxOccurs="1" />
				<element type="overtemp" minOccurs="0" maxOccurs="1" />
				<element type="is_enabled" minOccurs="0" maxOccurs="1" />
				<element type="amperage_primary_setpoint" minOccurs="0" maxOccurs="1" />
				<element type="amperage_background_setpoint" minOccurs="0" maxOccurs="1" />
				<element type="amperage_setpoint" minOccurs="0" maxOccurs="1" />
				<element type="amperage_primary_telemetry" minOccurs="0" maxOccurs="1" />
				<element type="amperage_background_telemetry" minOccurs="0" maxOccurs="1" />
				<element type="amperage_telemetry" minOccurs="0" maxOccurs="1" />
				<element type="voltage_primary_telemetry" minOccurs="0" maxOccurs="1" />
				<element type="voltage_background_telemetry" minOccurs="0" maxOccurs="1" />
				<element type="voltage_telemetry" minOccurs="0" maxOccurs="1" />
				<element type="contactor_status" minOccurs="0" maxOccurs="1" />
			</group>
			<group order="seq">
				<!--weldhead-->
				<element type="travel_jog_pos" minOccurs="0" maxOccurs="1" />
				<element type="travel_jog_neg" minOccurs="0" maxOccurs="1" />
				<element type="wire_jog_pos" minOccurs="0" maxOccurs="1" />
