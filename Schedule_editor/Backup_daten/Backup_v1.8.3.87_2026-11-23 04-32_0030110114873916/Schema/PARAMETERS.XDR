<Schema name="parameters" xmlns="urn:schemas-microsoft-com:xml-data" xmlns:dt="urn:schemas-microsoft-com:datatypes" xmlns:version="1.5.0.0">
  
  <ElementType name="Parameters" model="closed" content="eltOnly" order="seq">
    <AttributeType name="localeID" required="yes" dt:type="string" />
    <attribute type="localeID" />
    <element type="metadata" minOccurs="1" maxOccurs="1" />
    <element type="param" minOccurs="0" maxOccurs="*" />
  </ElementType>

  <ElementType name="param" model="closed" content="eltOnly" order="seq">
    <AttributeType name="id" required="yes" dt:type="int" />
    <attribute type="id" />
    <element type="name" minOccurs="1" maxOccurs="1" />
    <element type="short_name" minOccurs="1" maxOccurs="1" />
    <element type="desc" minOccurs="1" maxOccurs="1" />
    <element type="unit_mode" minOccurs="0" maxOccurs="*" />
  </ElementType>

  <ElementType name="unit_mode" model="closed" content="textOnly" order="seq">
    <AttributeType name="index" required="yes" dt:type="int" />
    <AttributeType name="name" required="yes" dt:type="string" />
    <attribute type="index" />
    <attribute type="name" />
  </ElementType>

  <ElementType name="name" model="closed"  dt:type="string" content="textOnly" />
  <ElementType name="short_name" model="closed"  dt:type="string" content="textOnly" />
  <ElementType name="desc" model="closed"  dt:type="string" content="textOnly" />
  
    <!--DECLARE ALL ELEMENTS (METADATA)-->
  <ElementType name="metadata" model="closed" content="eltOnly" order="seq">
    <element type="schema_version" minOccurs="1" maxOccurs="1" />
    <element type="config_version" minOccurs="1" maxOccurs="1" />
	  <element type="author" minOccurs="1" maxOccurs="1" />
	  <element type="date" minOccurs="1" maxOccurs="1" />
  </ElementType>

  <!--DEFINE ELEMENTS (METADATA)-->
  <ElementType name="schema_version" model="closed"  dt:type="string" content="textOnly" />
  <ElementType name="config_version" model="closed"  dt:type="string" content="textOnly" />
  <ElementType name="author" model="closed"  dt:type="string" content="textOnly" />
  <ElementType name="date" model="closed"  dt:type="string" content="textOnly" />

</Schema>