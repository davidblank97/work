<Schema name="WeldSchedule" xmlns="urn:schemas-microsoft-com:xml-data" xmlns:dt="urn:schemas-microsoft-com:datatypes" xmlns:version="1.8.3.7">

	<ElementType name="sched" model="closed" content="eltOnly" order="seq">
		<AttributeType name="id" required="no" dt:type="string" />
		<AttributeType name="type" required="no" dt:type="string" />
		<AttributeType name="head" required="yes" dt:type="string" />
		<attribute type="id" />
		<attribute type="type" />
		<attribute type="head" />
		<!--DECLARE ALL ELEMENTS (SCHED)-->
		<element type="metadata" minOccurs="1" maxOccurs="1" />
		<element type="description" minOccurs="1" maxOccurs="1" />
		<element type="global" minOccurs="1" maxOccurs="1" />
