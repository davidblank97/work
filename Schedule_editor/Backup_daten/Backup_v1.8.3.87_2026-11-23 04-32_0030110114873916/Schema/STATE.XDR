<Schema name="SYSTEM_STATES" xmlns="urn:schemas-microsoft-com:xml-data" xmlns:dt="urn:schemas-microsoft-com:datatypes" xmlns:version="1.6.3.0">
	<ElementType name="system_states" model="closed" content="eltOnly" order="seq">
		<!--DECLARE ALL ELEMENTS (system_states)-->
